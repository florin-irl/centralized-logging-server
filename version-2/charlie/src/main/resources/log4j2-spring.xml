<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="WARN">
    <Appenders>
        <!-- Console Appender using the EcsLayout -->
        <Console name="Console" target="SYSTEM_OUT">
            <EcsLayout serviceName="CharlieService"/>
        </Console>

        <!--
          THIS IS THE MODIFIED APPENDER
          It now rolls over daily and adds the date to the filename.
        -->
        <RollingFile name="EcsFile"
                     fileName="logs/charlie-service-ecs.log"
                     filePattern="logs/charlie-service-ecs-%d{yyyyMMdd}.json">
            <EcsLayout serviceName="CharlieService"/>
            <Policies>
                <!-- Rollover every day -->
                <TimeBasedTriggeringPolicy />
            </Policies>
            <!-- Optional: Keep only the last 7 days of logs -->
            <DefaultRolloverStrategy max="7"/>
        </RollingFile>

    </Appenders>

    <Loggers>
        <Logger name="com.example.charlie" level="info" additivity="false">
            <AppenderRef ref="Console"/>
            <AppenderRef ref="EcsFile"/>
        </Logger>

        <Root level="warn">
            <AppenderRef ref="Console"/>
            <AppenderRef ref="EcsFile"/>
        </Root>
    </Loggers>
</Configuration>